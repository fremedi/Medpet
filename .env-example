# WhatsApp Configuration
# Obtén estos valores de tu Meta/Facebook Business Account
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started

# Token de verificación para webhooks (puedes usar cualquier string)
WEBHOOK_VERIFY_TOKEN=tu_token_de_verificacion_aleatorio

# Token de acceso de WhatsApp Business API
API_TOKEN=EAABs...tu_token_de_acceso

# ID del número de teléfono de negocio (sin el signo +)
# Ejemplo: 5493585484890 (no incluir +)
BUSINESS_PHONE=tu_numero_sin_signo_mas

# Versión de WhatsApp Graph API
# Versiones recomendadas: v17.0, v18.0, v19.0
API_VERSION=v18.0

# Server Configuration
# Puerto en el que correrá el servidor
PORT=3000

# URL base de WhatsApp Graph API (no cambiar normalmente)
BASE_URL=https://graph.facebook.com

# OpenAI Configuration
# Obtén tu clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...tu_clave_api_openai

# Google Sheets Configuration (Opcional)
# Clave de API de Google Cloud (solo si usas Google Sheets)
GOOGLE_SPREADSHEET_ID=
